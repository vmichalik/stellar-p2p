# Public WalletConnect project ID, configured in the WalletConnect/Reown dashboard.
# Restrict its allowed origins to your actual HTTPS application origin.
PACTLANE_WALLETCONNECT_PROJECT_ID=YOUR_PUBLIC_PROJECT_ID
# Set both to the same HTTPS origin when an approved reverse proxy is used.
# PACTLANE_PUBLIC_ORIGIN=https://pactlane.io
# PACTLANE_WALLETCONNECT_APP_URL=https://pactlane.io
PACTLANE_LIVE_PORT=17862
# Optional existing trusted host module; never point this at an uploaded file.
# PACTLANE_HOST_MODULE=/absolute/private/operator-module.mjs
