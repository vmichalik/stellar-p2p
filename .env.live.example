# Local operator inputs only. Copy to an ignored private file and fill real values.
# Existing behavior defaults to testnet. Mainnet requires exactly "mainnet".
PACTLANE_NETWORK=testnet
PACTLANE_RPC_URL=
PACTLANE_ESCROW_CONTRACT=
PACTLANE_ESCROW_WASM_SHA256=
PACTLANE_TOKEN_CONTRACT=
PACTLANE_ASSET_CODE=
PACTLANE_ASSET_ISSUER=
PACTLANE_POLICY_PUBLIC_KEY_HEX=
PACTLANE_MAX_FEE_STROOPS=
PACTLANE_DEPLOYMENT_LEDGER=
PACTLANE_STORAGE_DIRECTORY=
# Absolute path to the same physical payment replay DB for the payment authority
# across all networks/deployments. Never silently start a replacement database.
PACTLANE_REPLAY_STORE_PATH=
PACTLANE_SUBMISSION_ENABLED=false
PACTLANE_ALLOW_MAINNET_SUBMISSION=false
# PACTLANE_HOST_MODULE must point to an operator-owned local module exporting
# createRuntime; integration/operator.example.mjs documents the composition.
# No deployment values, bank credentials, wallet secrets or live signing keys here.
