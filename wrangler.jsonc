{
  "name": "pactlane-demo",
  "main": "deploy/demo/worker.mjs",
  "compatibility_date": "2026-10-25",
  "workers_dev": false,
  "preview_urls": false,
  "upload_source_maps": false,
  "observability": { "enabled": false },
  "assets": {
    "directory": "./dist/demo",
    "binding": "ASSETS",
    "run_worker_first": true,
    "not_found_handling": "none",
  },
  "routes": [
    { "pattern": "pactlane.io", "custom_domain": true },
    { "pattern": "www.pactlane.io", "custom_domain": true },
    { "pattern": "app.pactlane.io", "custom_domain": true },
  ],
}
