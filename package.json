{
  "name": "stellar-p2p",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Pactlane: a payment-proof and Stellar escrow hackathon prototype.",
  "engines": {
    "node": ">=22.13"
  },
  "scripts": {
    "dev:app": "node scripts/serve-app.mjs",
    "test": "node --test tlsn/*.test.mjs tlsn/benchmark/*.test.mjs infra/proof-benchmark/*.test.mjs app/*.test.mjs tests/release/*.test.mjs",
    "test:app": "node --test app/*.test.mjs",
    "test:all": "node scripts/test-all.mjs",
    "setup:integration": "node scripts/setup-integration.mjs",
    "rehearse:local": "node scripts/rehearse-local.mjs",
    "test:release": "node --test tests/release/*.test.mjs",
    "build:demo": "node scripts/build-demo.mjs",
    "check": "node scripts/check.mjs",
    "start": "node --env-file=.env tlsn/launcher.mjs",
    "prepare:tlsn": "python3 scripts/prepare-tlsn.py",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "test:legacy": "npm --prefix archive/reclaim test",
    "prepare:benchmark": "python3 scripts/prepare-proof-benchmark.py",
    "test:benchmark-prep": "python3 -m unittest discover -s scripts -p \"test_prepare_proof_benchmark.py\"",
    "prepare:extension-setup60": "python3 scripts/prepare-extension-setup60.py",
    "dev:live": "node scripts/serve-live-app.mjs"
  },
  "devDependencies": {
    "prettier": "3.6.2"
  }
}
